# Copy to .env and fill in. Never commit .env.
DATABASE_URL=mysql://doite:CHANGE_ME@127.0.0.1:3306/doite
BIND_ADDR=127.0.0.1:3001
# true when served over HTTPS (adds the Secure flag to the session cookie)
COOKIE_SECURE=false
# How OTP codes are delivered. "log" prints them to the server console (testing only).
# Plug a real SMS provider into `send_otp` in src/auth.rs before going live.
SMS_MODE=log
# Optional: path to MaxMind GeoLite2-City.mmdb to show login locations (free, requires a MaxMind account).
# Without it, the account page shows "Chưa xác định vị trí" for public IPs.
GEOIP_DB=
# true only behind a trusted reverse proxy: take the client IP from X-Forwarded-For.
TRUST_PROXY=false
